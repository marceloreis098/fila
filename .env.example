# ---------------------------------------------------------------------------
# RELICVAULT — Variáveis de ambiente do servidor (Express)
# Copie este arquivo para .env e preencha os valores.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# APP_URL: URL pública onde a loja está hospedada (usada em webhooks de gateway).
# Ex: https://relicvault.com.br
# ---------------------------------------------------------------------------
APP_URL=""

# MASTER ADMINISTRATOR (autenticação REAL, server-side)
# Gere os valores com: npm run gen-secret
# ---------------------------------------------------------------------------
# E-mail do administrador master (login etapa 1).
ADMIN_EMAIL="admin@relicvault.com.br"

# Hash scrypt da senha no formato "salt:hash" (64 bytes hex).
# Em produção NÃO é aceita senha em texto puro (ADMIN_PASSWORD).
ADMIN_PASSWORD_HASH=""

# Secret TOTP base32 para o MFA (Google Authenticator / Authy).
# OPCIONAL: se vazio, o PRIMEIRO ACESSO ao painel libera o login para
# configurar o MFA via QR code (secret salvo em data/admin-auth.json,
# fora do git). Configure aqui se preferir um secret fixo de antemão.
ADMIN_TOTP_SECRET=""

# Chave que assina os tokens de sessão (64 hex chars).
# OBRIGATÓRIA em produção (fail-fast). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=""

# --------------
# REDE E SEGURANÇA
# --------------
# Porta do servidor (API + loja compilada).
PORT="4000"

# Defina true quando o servidor estiver atrás de um proxy reverso
# (Caddy, nginx, Cloudflare) para o rate limit usar o IP real do cliente.
TRUST_PROXY="false"

# NODE_ENV=production exige AUTH_SESSION_SECRET e bloqueia senha em texto.
# NODE_ENV="production"

# --------------
# GATEWAY PIX (opcional — ativa o checkout online)
# Depois de configurado, o checkout PIX real (Mercado Pago) é habilitado.
# Enquanto ausente, a venda acontece pelo WhatsApp (checkout desligado).
# Crie em: https://www.mercadopago.com.br/developers
MP_ACCESS_TOKEN=""

# --------------
# Credenciais para desenvolvimento (NUNCA em produção):
# ADMIN_PASSWORD="minha-senha-com-mais-de-12-caracteres"